# Apollo — ortam değişkenleri örneği (gerçek değerleri .env'e girin; .env commit edilmez)
DATABASE_URL=
NEXTAUTH_URL=https://apolloyonetim.com
NEXTAUTH_SECRET=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=

# SMS (NetGSM) — boşsa SMS devre dışı
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=

# E-posta (SMTP) — boşsa e-posta devre dışı
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Online ödeme: PAYMENT_PROVIDER=iyzico|paytr (boşsa devre dışı)
PAYMENT_PROVIDER=
PAYMENT_TEST_MODE=1
APP_URL=https://apolloyonetim.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_URI=https://sandbox-api.iyzipay.com
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
